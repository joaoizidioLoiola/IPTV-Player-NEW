{
    "appId": "com.iptvplayernew.desktop",
    "productName": "IPTV Player NEW",
    "copyright": "Copyright © 2026 IPTV Player NEW",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
        {
            "ext": "m3u",
            "name": "M3U Playlist",
            "description": "IPTV playlist",
            "mimeType": "audio/x-mpegurl",
            "role": "Viewer"
        },
        {
            "ext": "m3u8",
            "name": "M3U8 Playlist",
            "description": "IPTV playlist",
            "mimeType": "application/vnd.apple.mpegurl",
            "role": "Viewer"
        }
    ],
    "directories": {
        "buildResources": "dist/apps",
        "output": "dist/executables"
    },
    "files": [
        {
            "from": "dist/apps/remote-control-web",
            "to": "remote-control-web",
            "filter": ["**/*"]
        },
        "electron-backend/**/*",
        "!electron-backend/native{,/**/*}",
        "web/**/*",
        "!**/*.map",
        "!**/prebuilds/darwin-*.node",
        "!**/prebuilds/linux*.node",
        "!**/prebuilds/android-*.node",
        "!**/prebuilds/freebsd-*.node"
    ],
    "asarUnpack": [
        "**/better-sqlite3/**",
        "**/bindings/**",
        "**/file-uri-to-path/**",
        "**/*.node",
        "**/*.dylib",
        "**/*.dll",
        "**/*.so",
        "**/*.so.*",
        "**/embedded-mpv-runtime.json"
    ],
    "extraMetadata": {
        "name": "iptv-player-new",
        "productName": "IPTV Player NEW",
        "desktopName": "iptv-player-new",
        "main": "electron-backend/main.js"
    },
    "extraResources": ["dist/apps/electron-backend/workers"],
    "publish": [
        {
            "provider": "github",
            "owner": "joaoizidioLoiola",
            "repo": "IPTV-Player-NEW"
        }
    ],
    "win": {
        "compression": "maximum",
        "target": [
            {
                "target": "nsis",
                "arch": ["x64"]
            }
        ],
        "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}",
        "icon": "apps/web/src/assets/icons/icon.png",
        "signExts": [".dll", ".node"],
        "signtoolOptions": {
            "signingHashAlgorithms": ["sha256"]
        }
    },
    "nsis": {
        "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}"
    }
}
